	measure 'YoY ilość' =
			
			VAR CurrentYear= [Ilość turystów]
			VAR LastYear= CALCULATE([Ilość turystów], SAMEPERIODLASTYEAR(Dim_Date[Date]))
			Return
			CurrentYear-LastYear
		lineageTag: f607216a-e652-494a-afe7-a7ca645ddab7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YoY % ilość' =
			
			VAR CurrentYear= [Ilość turystów]
			VAR LastYear= CALCULATE([Ilość turystów], SAMEPERIODLASTYEAR(Dim_Date[Date]))
