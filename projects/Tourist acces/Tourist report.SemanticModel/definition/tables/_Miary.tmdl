table _Miary
	lineageTag: e9d56087-61af-46ef-9286-fabbc79e45c8

	measure 'Suma Turystów' = SUM(df_final[Turysci])
		formatString: #,0
		lineageTag: b074d660-796a-4032-b745-5c6b68cab2e1

	measure 'Suma Noclegów' = Sum(df_final[Noclegi])
		formatString: #,0
		lineageTag: 989defc6-7690-4994-b080-65210cc3f18d

	measure 'Filtr Top N' =
			
			VAR WybraneN = [Top N — wartość]-- Tu wstaw nazwę miary wygenerowanej przez parametr
			VAR Ranga = RANKX(ALLSELECTED('Dim_Kraje_Master'[Kraj]), [Suma Turystów], , DESC, Dense)
			RETURN
			IF(Ranga <= WybraneN, 1, 0)
		lineageTag: a34c5aa1-74e2-4662-a284-14496199029e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Obiekty_Turyści Zagraniczni' = SUM(Obiekty[Turyści_Zagraniczni])
		formatString: #,0.00
		lineageTag: d2a22346-c924-4a61-b187-994326436fb0

	measure 'YoY %' =
			
			VAR RokBiezacy = [Ilość turystów]
			VAR RokPoprzedni = CALCULATE([Ilość turystów], SAMEPERIODLASTYEAR('Dim_Date'[Date]))
			RETURN
			DIVIDE(RokBiezacy - RokPoprzedni, RokPoprzedni)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c28170ce-2842-4ad9-8e36-ac259cfd36d2

	measure YoY =
			
			VAR RokBiezacy = [Ilość turystów]
			VAR RokPoprzedni = CALCULATE([Ilość turystów], SAMEPERIODLASTYEAR('Dim_Date'[Date]))
			RETURN
			RokPoprzedni
		lineageTag: f3d7dfce-c78f-4d12-aaf1-93c5445d8f74

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YoY Obiekty ogół' = ```
			
			VAR TenRok= [Turyści ogółem]
			VAR ZeszlyRok=CALCULATE([Turyści ogółem],SAMEPERIODLASTYEAR(Dim_Date[Date]))
			Return 
			TenRok-ZeszlyRok
			```
		lineageTag: 8a1ba0f4-e9f8-4ad3-890d-dc7af8ffeb2a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YoY % obiekty ogół' =
			
			VAR Teraz= [Turyści ogółem]
			VAR ZeszlyRok= CALCULATE([Turyści ogółem],SAMEPERIODLASTYEAR(Dim_Date[Date]))
			RETURN
			DIVIDE(Teraz-ZeszlyRok,ZeszlyRok)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ed7c0fde-e670-441f-8879-69d39d9e1fe7

	measure 'YoY % obiekty krajowi' =
			
			VAR Teraz= [Turyści krajowi]
			VAR ZeszlyRok= CALCULATE([Turyści krajowi],SAMEPERIODLASTYEAR(Dim_Date[Date]))
			RETURN
			DIVIDE(Teraz-ZeszlyRok,ZeszlyRok)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 601b836f-726e-4311-a394-bda70ff9ded7

	measure 'YoY % obiekty zagraniczni' =
			
			VAR Teraz= [Obiekty_Turyści Zagraniczni]
			VAR ZeszlyRok= CALCULATE([Obiekty_Turyści Zagraniczni],SAMEPERIODLASTYEAR(Dim_Date[Date]))
			RETURN
			DIVIDE(Teraz-ZeszlyRok,ZeszlyRok)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0d992181-89c4-4d87-9a13-a50d1c53f66c

	measure 'YoY Obiekty krajowi' = ```
			
			VAR TenRok= [Turyści krajowi]
			VAR ZeszlyRok=CALCULATE([Turyści krajowi],SAMEPERIODLASTYEAR(Dim_Date[Date]))
			Return 
