annotation PBI_QueryOrder = ["Turyści per Woj/pow","Dim_Geo","Dim_Kraje","df_final","_Miary","Parametr1","Przykładowy plik","Przekształć plik","Obiekty"]

annotation __TEdtr = 1

annotation PBI_ProTooling = ["DevMode"]

